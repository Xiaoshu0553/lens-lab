# 先运行 python3 scripts/setup.py 自动生成本地 .env 和管理员密码
# 服务器部署时填自己的域名；本地运行可留空
STUDY_DOMAIN=
STUDY_MODE=demo
DATABASE_PATH=./data/lens.sqlite3
ADMIN_PASSWORD=请由_setup_脚本生成
ASSIGNMENT_SEED=请由_setup_脚本生成
PARTICIPANT_ACCESS_CODE=
MINOR_ACCESS_CODE=
UNDER14_PRIVACY_NOTICE_URL=
GROUP_CAP=0
MAX_TURNS=12
MAX_MINUTES=30
LITERACY_BAND_WIDTH=10
CLARIFICATION_STRATEGY=module

# 本地真实模型预测试：STUDY_MODE=pilot，地址可用 http://127.0.0.1:11434/v1
# 提示词澄清试验：CLARIFICATION_STRATEGY=prompt；module 是现有独立判断模块
# DeepSeek API 预测试：STUDY_MODE=pilot；正式实验：STUDY_MODE=live
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=
MODEL_NAME=deepseek-flash
MODEL_TEMPERATURE=0
MODEL_THINKING=disabled
MODEL_MAX_TOKENS=800
