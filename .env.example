# 先运行 python3 scripts/setup.py 自动生成本地 .env 和管理员密码
# 服务器部署时填自己的域名；本地运行可留空
STUDY_DOMAIN=
STUDY_MODE=demo
DATABASE_PATH=./translation-data/lens.sqlite3
ADMIN_PASSWORD=请由_setup_脚本生成
ASSIGNMENT_SEED=请由_setup_脚本生成
PARTICIPANT_ACCESS_CODE=
MINOR_ACCESS_CODE=
UNDER14_PRIVACY_NOTICE_URL=
GROUP_CAP=0
MAX_TURNS=12
MAX_MINUTES=30
LITERACY_BAND_WIDTH=10
CLARIFICATION_STRATEGY=prompt
# 同域独立真实模型试跑：由 compose.preview.yaml 设置 /preview-api；普通部署留空
PREVIEW_API_PREFIX=
# 设为 1 时，API 仅供已登录管理员试跑，不能创建普通参与者记录
RESEARCHER_PREVIEW_ONLY=0

# 本地真实模型预测试：STUDY_MODE=pilot，地址可用 http://127.0.0.1:11434/v1
# 翻译研究当前仅 S 直接翻译／A 主动澄清，共用同一基础模型；优化模块待实证结论后设计
# demo 不调用 API；填写配置不代表已实际连通，真实预测试需验证成功调用
# CLARIFICATION_STRATEGY 是历史校园任务的兼容配置，不选择翻译实验条件
# DeepSeek API 预测试：STUDY_MODE=pilot；正式实验：STUDY_MODE=live
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=自行填写API
MODEL_NAME=deepseek-flash
MODEL_TEMPERATURE=0
MODEL_THINKING=disabled
MODEL_MAX_TOKENS=1600

# 多模型评审在管理员后台“模型配置”中单独设置：至少5个不同模型，每个完整评分5个维度。
# 每个评审模型可有独立接口/模型名/API密钥/权重；默认模型权重等权1。
# 私有后台配置默认写入 .translation-models.json（已忽略Git和Docker构建），不会写回本.env。
# 可用 TRANSLATION_MODELS_PATH 设置独立私有配置文件路径（容器应持久化该路径）。
# compose.yaml 固定为 /app/data/.translation-models.json，随 translation-data/ 持久化。
TRANSLATION_MODELS_PATH=./.translation-models.json
# 保存配置后执行实际连通检查；某模型未返回有效评分时，不用其余模型临时计算综合分。
