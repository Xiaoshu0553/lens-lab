# 先运行 python3 scripts/setup.py 自动生成本地 .env 和管理员密码
# 服务器部署时填自己的域名；本地运行可留空
STUDY_DOMAIN=
STUDY_MODE=demo
DATABASE_PATH=./university-data/lens.sqlite3
ADMIN_PASSWORD=请由_setup_脚本生成
ASSIGNMENT_SEED=请由_setup_脚本生成
PARTICIPANT_ACCESS_CODE=
MINOR_ACCESS_CODE=
UNDER14_PRIVACY_NOTICE_URL=
GROUP_CAP=0
MAX_TURNS=12
MAX_MINUTES=30
LITERACY_BAND_WIDTH=10
CLARIFICATION_STRATEGY=prompt
# 同域独立真实模型试跑：由 compose.preview.yaml 设置 /preview-api；普通部署留空
PREVIEW_API_PREFIX=
# 设为 1 时，API 仅供已登录管理员试跑，不能创建普通参与者记录
RESEARCHER_PREVIEW_ONLY=0

# 本地真实模型预测试：STUDY_MODE=pilot，地址可用 http://127.0.0.1:11434/v1
# 两组使用同一模型；澄清组额外接收主动澄清提示词。旧值 module 兼容映射为 prompt
# DeepSeek API 预测试：STUDY_MODE=pilot；正式实验：STUDY_MODE=live
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=自行填写API
MODEL_NAME=deepseek-flash
MODEL_TEMPERATURE=0
MODEL_THINKING=disabled
MODEL_MAX_TOKENS=1600
